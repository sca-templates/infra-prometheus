# =============================================================================
# prometheus — Environment Variables
# =============================================================================
# Local: `.env` is generated with `make env` from Vault
# (secret/postgres-app/dev + secret/redis/dev).
# Do not edit it manually. Secrets (DATA_SOURCE_NAME, REDIS_PASSWORD) are
# written by scripts/gen-env.sh and never committed.
# Production: provision this file with Ansible / AWS Secrets Manager.
# =============================================================================

# ── Project ─────────────────────────────────────────────────────────────────
ENVIRONMENT=dev

# ── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ── Exporters (host ports) ──────────────────────────────────────────────────
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
KAFKA_CONNECT_EXPORTER_PORT=9309
KAFKA_EXPORTER_PORT=9308
